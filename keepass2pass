def info(message: str) -> None:
    print(f"[INFO] {message}")


def warn(message: str) -> None:
    print(f"[WARN] {message}", file=sys.stderr)


def error(message: str) -> None:
    print(f"[ERROR] {message}", file=sys.stderr)


def sanitize_component(name: str) -> str:
    """Make one path component safe for pass: no '/', no control characters,
    never '.' or '..', never empty."""
    name = CONTROL_CHARS.sub("_", name).strip()
    if name in {".", ".."}:
        name = "_"
    return name or PLACEHOLDER


def join_path(parent: str, child: str) -> str:
    return f"{parent}/{child}" if parent else child


def normalize_root(root: str) -> str:
    """'a//b/' -> 'a/b'; '' stays '' (flat structure)."""
    return "/".join(sanitize_component(part) for part in root.split("/") if part.strip())


def entry_fields(entry: ElementTree.Element) -> Dict[str, str]:
    """All <String> key/value pairs of an entry (first occurrence wins)."""
    fields: Dict[str, str] = {}
    for node in entry.findall("String"):
        key = node.findtext("Key")
        if key and key not in fields:
            fields[key] = node.findtext("Value") or ""
    return fields


def format_entry(entry: ElementTree.Element, fields: Dict[str, str], label: str) -> str:
    """Render an entry in pass format. The first line is ALWAYS the password
    (empty if there is none), so that `pass -c` never copies a metadata line.
    Returns "" for entries with no content at all."""
    password = fields.get("Password", "")
    lines = [password]
    for key in ("UserName", "URL"):
        if fields.get(key):
            lines.append(f"{key}: {fields[key]}")
    for key, value in fields.items():
        if key in HANDLED_KEYS or not value:
            continue
        # pass-otp looks for a bare otpauth:// line, so no "key: " prefix
        lines.append(value if value.startswith("otpauth://") else f"{key}: {value}")
    tags = entry.findtext("Tags")
    if tags:
        lines.append(f"Tags: {tags}")
    if fields.get("Notes"):
        lines.append(f"Notes: {fields['Notes']}")

    if not any(lines):
        return ""
    if not password:
        warn(f"no password: {label}")

    for attachment in entry.findall("Binary"):
        warn(f"attachment {attachment.findtext('Key')!r} is not imported: {label}")
    if any("{REF:" in value for value in fields.values()):
        warn(f"contains a KeePass field reference ({{REF:...}}), copied literally: {label}")

    return "\n".join(lines) + "\n"


class Collector:
    """Walks the KeePass tree and collects `pass path -> entry text`."""

    def __init__(self, duplicates: str, bin_uuid: Optional[str]) -> None:
        self.entries: Dict[str, str] = {}
        self.duplicates = duplicates  # "ask", "merge" or "split"
        self.bin_uuid = bin_uuid

    def add_group(self, group: ElementTree.Element, path: str) -> None:
        """`path` is the final pass path of THIS group ("" = top level)."""
        for sub in group.findall("Group"):
            if self.bin_uuid and sub.findtext("UUID") == self.bin_uuid:
                info(f"skipping Recycle Bin: {join_path(path, sanitize_component(sub.findtext('Name') or ''))}")
                continue
            name = sanitize_component(sub.findtext("Name") or "")
            self.add_group(sub, join_path(path, name))
        for entry in group.findall("Entry"):
            self.add_entry(entry, path)

    def add_entry(self, entry: ElementTree.Element, group_path: str) -> None:
        fields = entry_fields(entry)
        path = join_path(group_path, sanitize_component(fields.get("Title", "")))
        data = format_entry(entry, fields, path)
        if not data:
            warn(f"empty entry skipped: {path}")
            return


def pass_import_entry(path, data):
    """Import new password entry into the password-store via stdin"""
    run(
        ["pass", "insert", "--multiline", path],
        input=data,
        text=True,
        stdout=PIPE,
        stderr=PIPE,
    )


def import_entry(entries, element, path=""):
    """Extracts data and prompts the user on how to handle duplicates"""
    global DUPLICATE_STRATEGY
    base_path = path_for(element, path)
    new_data = password_data(element, path)

    if base_path in entries:
        if DUPLICATE_STRATEGY in ["ma", "sa"]:
            choice = "m" if DUPLICATE_STRATEGY == "ma" else "s"
        else:
            print(f"\n[!] Duplicate found for path: {base_path}")

            while True:
                choice = (
                    input(
                        "    Choose action - [m]erge, [s]plit, merge [ma]ll, split [sa]ll? (m/s/ma/sa): "
                    )
                    .strip()
                    .lower()
                )
                if choice in ["m", "s", "ma", "sa"]:
                    break
                print("    Invalid input. Please enter 'm', 's', 'ma', or 'sa'.")

            if choice in ["ma", "sa"]:
                DUPLICATE_STRATEGY = choice
                choice = "m" if choice == "ma" else "s"

        if choice == "m":
            print(f"[INFO] Merging duplicate into: {base_path}")
            existing_data = entries[base_path]
            entries[base_path] = f"{existing_data}---------\nPassword: {new_data}"
        else:
            element_path = base_path
            counter = 1
            while element_path in entries:
                counter += 1
                element_path = f"{base_path}_{counter}"
            print(f"[INFO] Splitting duplicate into: {element_path}")
            entries[element_path] = new_data
    else:
        entries[base_path] = new_data


def import_group(entries, element, path="", npath=None):
    """Import all entries and sub-groups from given group"""
    if npath is None:
        npath = path_for(element, path)
    for group in element.findall("Group"):
        import_group(entries, group, npath)
    for entry in element.findall("Entry"):
        import_entry(entries, entry, npath)


def import_passwords(xml_file, root_path=None):
    """Parse given Keepass2 XML file and import password groups from it"""
    print(f"[>>>>] Importing passwords from file {xml_file}")
    print(f"[INFO] Root path: {root_path}")
    entries = dict()
    with open(xml_file, encoding="utf-8") as xml:
        text = xml.read()
        xml_tree = ElementTree.XML(text)
        root = xml_tree.find("Root")
        if root is None:
            print("[ERROR] Root path not found in XML")
            return
        root_group = root.find("Group")
        if root_group is None:
            print("[ERROR] Root Group not found in XML")
            return

        if root_path is None:
            import_group(entries, root_group, "")
        else:
            import_group(entries, root_group, "", root_path)

        password_count = 0
        for path, data in sorted(entries.items()):
            sys.stdout.write(f"[>>>>] Importing {path} ... ")
            sys.stdout.flush()
            pass_import_entry(path, data)
            sys.stdout.write("OK\n")
            password_count += 1

        print(f"[ OK ] Done. Imported {password_count} passwords.")


def usage():
    """Print usage"""
    print(f"Usage: {sys.argv[0]} -f XML_FILE")
    print("Optional:")
    print(
        "  -r ROOT_PATH    Specify a custom root folder instead of the default XML root"
    )


def main(argv):
    try:
        opts, args = getopt.gnu_getopt(argv, "f:r:")
        if args:
            print(f"[ERROR] Unexpected arguments: {args}")
            usage()
            sys.exit(2)

    except getopt.GetoptError as err:
        print(str(err))
        usage()
        sys.exit(2)

    xml_file = None
    root_path = None

    for opt, arg in opts:
        if opt == "-f":
            xml_file = arg
        if opt == "-r":
            root_path = arg

    if xml_file is not None:
        import_passwords(xml_file, root_path)
    else:
        usage()
        sys.exit(2)
def warn_case_collisions(paths: List[str]) -> None:
    seen: Dict[str, str] = {}
    for path in sorted(paths):
        key = path.casefold()
        if key in seen:
            warn(f"paths differ only by case (collide on case-insensitive filesystems): "
                 f"{seen[key]} / {path}")
        seen[key] = path




if __name__ == "__main__":
    main(sys.argv[1:])
